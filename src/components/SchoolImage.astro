---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/*.png", {
  eager: true,
});
const { name, alt, width = 700, loading = "lazy", fetchpriority } = Astro.props;
const source = images[`../assets/${name}`]?.default;
if (!source) throw new Error(`Imagem ausente: ${name}`);
const size = Math.min(width, source.width);
---

<Image
  src={source}
  alt={alt}
  width={size}
  widths={[Math.min(400, size), size]}
  sizes={size > 1000 ? "100vw" : "(max-width: 767px) 90vw, 50vw"}
  format="webp"
  quality={85}
  loading={loading}
  fetchpriority={fetchpriority}
/>
